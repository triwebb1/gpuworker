gpuworker.toml
/status.json
footprints.json
*.log

# Staged weight caches are large + per-host (SPEC 6.2); keep the dir, not contents
/weights/*
!/weights/README.md
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# Local queue trees, broker state, job payloads and generated outputs
/queues/
/state/
/jobs/
/outputs/
